# Backend only: never prefix private credentials with VITE_.
TMDB_API_KEY=replace_with_a_new_key
PORT=3000

# Public Firebase web configuration (these are identifiers, not admin secrets).
# Copy the values from your Firebase web app configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional authorized stream providers, server only. Leave blank for public demo.
STREAM_LIBRARY_HOSTS=
STREAM_LIBRARY_JSON=
STREAM_PARTNER_ENDPOINT=
STREAM_PARTNER_API_HOSTS=
STREAM_PARTNER_MEDIA_HOSTS=
STREAM_PARTNER_TOKEN=
# Functions runtime: same public Firebase identifiers as the web application.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=

# --- API vidéo (dossier /api, voir docs/VIDEO.md) ---------------------------
# Origines autorisées par CORS, séparées par des virgules.
ALLOWED_ORIGINS=https://altyflix.netlify.app,http://localhost:5173
# Secret de signature des URLs de lecture (identique dans le Worker Cloudflare).
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PLAYBACK_SIGNING_SECRET=
# Durée de validité d'une URL de lecture, en secondes (6 h par défaut).
PLAYBACK_URL_TTL=21600
# Racine des médias : http://localhost:3100/media en local, https://media.votre-domaine.fr en production.
MEDIA_BASE_URL=http://localhost:3100/media
MEDIA_LOCAL_DIR=media
VIDEO_API_PORT=3100
# "firestore" (production) ou "file" (développement sans compte de service, données dans .data/).
DATA_BACKEND=firestore
# Compte de service Firebase (console Firebase > Paramètres > Comptes de service). Ne jamais préfixer par VITE_.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Développement uniquement : traite toutes les requêtes comme cet utilisateur, sans vérifier de jeton.
# Ignoré par la fonction Netlify. Laisser vide en dehors des tests locaux.
AUTH_DEV_UID=

# Côté navigateur : adresse de l'API vidéo en développement (laisser vide en production).
VITE_VIDEO_API_BASE=http://localhost:3100
# Développement uniquement : ouvre /watch sans connexion (à utiliser avec AUTH_DEV_UID).
VITE_VIDEO_DEV_NOAUTH=
