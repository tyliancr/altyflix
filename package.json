{
  "name": "atflix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server-vf-api.cjs",
    "start": "node server/server-vf-api.cjs",
    "build:function": "node tools/bundle-function.mjs",
    "build": "npm run build:function && vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "node --test tests/auth.test.js tests/security.test.js tests/stream-v1.test.js tests/streaming-engine.test.js tests/debrid-stream-resolver.test.js",
    "check:structure": "node tools/check-structure.mjs",
    "check": "npm run check:structure && npm run lint && npm test && npm run build",
    "bench:stream": "node tools/bench-stream.mjs",
    "deploy": "npm run build && npx netlify deploy --prod --dir=dist --functions=netlify/functions",
    "deploy:preview": "npm run build && npx netlify deploy --dir=dist --functions=netlify/functions"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "date-fns": "^4.2.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "firebase": "^12.13.0",
    "framer-motion": "^11.18.2",
    "helmet": "^8.3.0",
    "hls.js": "^1.7.4",
    "ipaddr.js": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.15.1",
    "shaka-player": "^5.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-unused-imports": "^3.2.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
